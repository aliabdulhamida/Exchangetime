# Yahoo Finance is the primary provider for stock/quote data.
# No API key required for Yahoo server-side proxy endpoints.

# Optional fallback provider #1: Financial Modeling Prep
# Get it from: https://financialmodelingprep.com/
# Required for the market-wide insider scanner. Issuer history falls back to Nasdaq without a key.
FMP_API_KEY=your_fmp_api_key_here

# Public legal disclosures. Never infer these from a developer account.
SITE_OPERATOR_NAME=
SITE_OPERATOR_ADDRESS=
SITE_OPERATOR_EMAIL=
SITE_OPERATOR_REPRESENTATIVE=
SITE_OPERATOR_REGISTER=
SITE_OPERATOR_VAT_ID=
SITE_EDITOR_NAME=
SITE_EDITOR_ADDRESS=
# Hosting identity, regions, subprocessors, retention and transfer safeguards
SITE_HOSTING_DISCLOSURE=
# Fill only after confirming applicability under section 36 VSBG
SITE_DISPUTE_DISCLOSURE=

# Optional fallback provider #2 (used when Yahoo and FMP are unavailable)
# Get it from: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here

# Optional fallback provider #3 (used when Yahoo/FMP/Twelve Data are unavailable)
# Get it from: https://massive.com/ or https://polygon.io/
MASSIVE_API_KEY=your_massive_api_key_here

# Optional: RapidAPI key for Fear & Greed Index proxy endpoint (/api/fear-greed)
# Get it from: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: client-side fallback key for Fear & Greed on static hosts (no /api runtime).
# Warning: NEXT_PUBLIC_* variables are exposed in the browser bundle.
NEXT_PUBLIC_RAPIDAPI_KEY=
