# Yahoo Finance is the primary provider for stock/quote data.
# No API key required for Yahoo server-side proxy endpoints.

# Optional fallback provider #1: Financial Modeling Prep
# Get it from: https://financialmodelingprep.com/
# Used when Yahoo data is missing/unavailable (DCF, advanced metrics, and compatibility fallbacks)
FMP_API_KEY=your_fmp_api_key_here

# Optional fallback provider #2 (used when Yahoo and FMP are unavailable)
# Get it from: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here

# Optional fallback provider #3 (used when Yahoo/FMP/Twelve Data are unavailable)
# Get it from: https://massive.com/ or https://polygon.io/
MASSIVE_API_KEY=your_massive_api_key_here

# Optional: RapidAPI key for Fear & Greed Index proxy endpoint (/api/fear-greed)
# Get it from: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here
